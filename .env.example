# Copy to .env and adjust. Docker Compose reads it automatically.

# ── Local try-out (defaults) ─────────────────────────────────
# PIMED_SITE=:80
# PIMED_COOKIE_SECURE=false
# PIMED_HTTP_PORT=80

# ── Raspberry Pi over Tailscale (HTTPS) ──────────────────────
# Your Pi's MagicDNS name (see `tailscale status` / admin console).
PIMED_SITE=pimed.your-tailnet.ts.net
PIMED_COOKIE_SECURE=true
# Publish Caddy only on the Pi's Tailscale IP, so it's not reachable from the LAN.
PIMED_BIND_IP=100.x.y.z

# ── Optional ─────────────────────────────────────────────────
# Store files on an external disk instead of a Docker volume:
# PIMED_DATA_PATH=/mnt/pimed
# PIMED_HTTP_PORT=80
# PIMED_HTTPS_PORT=443
# PIMED_SESSION_TTL=720h
# PIMED_LOG_LEVEL=info

# PiMed settings for the systemd service. Copy to /etc/pimed/pimed.env.
# Full reference: docs/api.md → "Configuration".

# Only Caddy on this machine talks to the backend.
PIMED_ADDR=127.0.0.1:8080

# Files/media root. Change to your external disk mount later (and add it to
# ReadWritePaths in pimed.service).
PIMED_DATA_DIR=/data

# SQLite database (directory is created by systemd's StateDirectory).
PIMED_DB_PATH=/var/lib/pimed/pimed.db

# Caddy serves HTTPS, so cookies must be Secure.
PIMED_COOKIE_SECURE=true

# Caddy runs on the same host.
PIMED_TRUSTED_PROXIES=127.0.0.1/32,::1/128

PIMED_SESSION_TTL=720h
PIMED_LOG_LEVEL=info
